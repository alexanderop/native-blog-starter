{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "lib/**/*.mjs",
    "lib/**/*.d.ts",
    "templates/**/*.mjs",
    "scripts/**/*.mjs",
    "site.config.mjs"
  ]
}
